generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Project {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(150)
  contractValue    Decimal           @default(0.00) @db.Decimal(15, 2)
  notes            String?           @db.Text
  status           ProjectStatus     @default(ONGOING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  boqs             BOQ[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  purchases        Purchase[]
  rfqs             RFQ[]
  stockMovements   StockMovement[]
  transactions     Transaction[]

  @@map("projects")
}

model Worker {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  role         String?       @db.VarChar(100)
  status       RecordStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("workers")
}

model Vendor {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(150)
  companyName    String?               @db.VarChar(150)
  phone          String?               @db.VarChar(30)
  address        String?               @db.Text
  status         RecordStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]
  rfqVendors     RFQVendor[]
  awardedRFQs    RFQ[]                 @relation("RFQAwardedVendor")
  transactions   Transaction[]
  materialPrices VendorMaterialPrice[]

  @@map("vendors")
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(100)
  type         TransactionType
  status       RecordStatus    @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]

  @@unique([name, type])
  @@map("categories")
}



enum TransactionSource {
  MANUAL
  PURCHASE
  PURCHASE_PAYMENT
}

model Transaction {
  id              Int             @id @default(autoincrement())
  transactionDate DateTime
  type            TransactionType
  source          TransactionSource @default(MANUAL)
  amount          Decimal         @db.Decimal(15, 2)
  paymentMethod   PaymentMethod   @default(CASH)
  description     String?         @db.Text
  notes           String?         @db.Text
  projectId       Int?
  categoryId      Int?
  workerId        Int?
  vendorId        Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category?       @relation(fields: [categoryId], references: [id])
  project         Project?        @relation(fields: [projectId], references: [id])
  vendor          Vendor?         @relation(fields: [vendorId], references: [id])
  worker          Worker?         @relation(fields: [workerId], references: [id])

  @@index([transactionDate])
  @@index([type])
  @@index([projectId])
  @@index([categoryId], map: "transactions_categoryId_fkey")
  @@index([vendorId], map: "transactions_vendorId_fkey")
  @@index([workerId], map: "transactions_workerId_fkey")
  @@map("transactions")
}

model MaterialCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  materials   Material[]

  @@map("material_categories")
}

model Material {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique @db.VarChar(50)
  name                 String                @db.VarChar(150)
  categoryId           Int?
  subCategory          String?               @db.VarChar(100)
  brand                String?               @db.VarChar(100)
  modelCode            String?               @db.VarChar(100)
  specification        String?               @db.Text
  color                String?               @db.VarChar(100)
  size                 String?               @db.VarChar(100)
  unit                 String                @db.VarChar(30)
  description          String?               @db.Text
  status               RecordStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  boqItems             BOQItem[]
  category             MaterialCategory?     @relation(fields: [categoryId], references: [id])
  purchaseItems        PurchaseItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]
  rfqItems             RFQItem[]
  stockMovements       StockMovement[]
  vendorPrices         VendorMaterialPrice[]

  @@index([categoryId])
  @@index([name])
  @@index([brand])
  @@map("materials")
}

model Purchase {
  id            Int                   @id @default(autoincrement())
  purchaseNo    String                @unique @db.VarChar(50)
  purchaseDate  DateTime
  vendorId      Int
  projectId     Int?
  subtotal      Decimal               @default(0.00) @db.Decimal(15, 2)
  discount      Decimal               @default(0.00) @db.Decimal(15, 2)
  transportCost Decimal               @default(0.00) @db.Decimal(15, 2)
  grandTotal    Decimal               @default(0.00) @db.Decimal(15, 2)
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  paidAmount    Decimal               @default(0.00) @db.Decimal(15, 2)
  dueAmount     Decimal               @default(0.00) @db.Decimal(15, 2)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         PurchaseItem[]
  purchaseOrder PurchaseOrder?        @relation("PurchaseOrderPurchase")
  payments      PurchasePayment[]
  project       Project?              @relation(fields: [projectId], references: [id])
  vendor        Vendor                @relation(fields: [vendorId], references: [id])

  @@index([purchaseDate])
  @@index([vendorId])
  @@index([projectId])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchasePayment {
  id            Int           @id @default(autoincrement())
  purchaseId    Int
  paymentDate   DateTime
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @default(CASH)
  referenceNo   String?       @db.VarChar(100)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([paymentDate])
  @@map("purchase_payments")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  materialId Int
  quantity   Decimal  @db.Decimal(15, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(15, 3)
  unit       String   @db.VarChar(30)
  unitPrice  Decimal  @db.Decimal(15, 2)
  total      Decimal  @db.Decimal(15, 2)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  material   Material @relation(fields: [materialId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([materialId])
  @@map("purchase_items")
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  materialId    Int
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(15, 3)
  unit          String            @db.VarChar(30)
  referenceType String?           @db.VarChar(50)
  referenceId   Int?
  projectId     Int?
  unitCost      Decimal?          @db.Decimal(15, 2)
  notes         String?           @db.Text
  movementDate  DateTime          @default(now())
  createdAt     DateTime          @default(now())
  material      Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id])

  @@index([materialId])
  @@index([movementType])
  @@index([movementDate])
  @@index([projectId])
  @@map("stock_movements")
}

model BOQ {
  id        Int       @id @default(autoincrement())
  boqNo     String    @unique @db.VarChar(50)
  name      String    @db.VarChar(150)
  projectId Int
  status    BOQStatus @default(DRAFT)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     BOQItem[]
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("boqs")
}

model BOQItem {
  id                 Int      @id @default(autoincrement())
  boqId              Int
  materialId         Int
  description        String?  @db.Text
  quantity           Decimal  @db.Decimal(15, 3)
  unit               String   @db.VarChar(30)
  estimatedUnitPrice Decimal  @default(0.00) @db.Decimal(15, 2)
  estimatedTotal     Decimal  @default(0.00) @db.Decimal(15, 2)
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  boq                BOQ      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  material           Material @relation(fields: [materialId], references: [id])

  @@index([boqId])
  @@index([materialId])
  @@map("boq_items")
}

model VendorMaterialPrice {
  id            Int      @id @default(autoincrement())
  materialId    Int
  vendorId      Int
  unitPrice     Decimal  @db.Decimal(15, 2)
  unit          String   @db.VarChar(30)
  minimumQty    Decimal? @db.Decimal(15, 2)
  leadTimeDays  Int?
  effectiveDate DateTime @default(now())
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([vendorId])
  @@index([materialId, vendorId])
  @@index([effectiveDate])
  @@map("vendor_material_prices")
}

model PurchaseRequest {
  id          Int                     @id @default(autoincrement())
  requestNo   String                  @unique @db.VarChar(50)
  requestDate DateTime
  projectId   Int
  status      PurchaseRequestStatus   @default(DRAFT)
  priority    PurchaseRequestPriority @default(NORMAL)
  notes       String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       PurchaseRequestItem[]
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([requestDate])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int
  materialId        Int
  quantity          Decimal         @db.Decimal(15, 3)
  unit              String          @db.VarChar(30)
  requiredDate      DateTime?
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  material          Material        @relation(fields: [materialId], references: [id])
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([materialId])
  @@map("purchase_request_items")
}

model RFQ {
  id              Int             @id @default(autoincrement())
  rfqNo           String          @unique @db.VarChar(50)
  rfqDate         DateTime
  projectId       Int
  status          RFQStatus       @default(DRAFT)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  awardedVendorId Int?
  purchaseOrders  PurchaseOrder[]
  items           RFQItem[]
  vendors         RFQVendor[]
  awardedVendor   Vendor?         @relation("RFQAwardedVendor", fields: [awardedVendorId], references: [id])
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([rfqDate])
  @@index([awardedVendorId], map: "rfqs_awardedVendorId_fkey")
  @@map("rfqs")
}

model RFQVendor {
  id          Int      @id @default(autoincrement())
  rfqId       Int
  vendorId    Int
  quotedTotal Decimal? @db.Decimal(15, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@map("rfq_vendors")
}

model RFQItem {
  id         Int      @id @default(autoincrement())
  rfqId      Int
  materialId Int
  quantity   Decimal  @db.Decimal(15, 3)
  unit       String   @db.VarChar(30)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  material   Material @relation(fields: [materialId], references: [id])
  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([materialId])
  @@map("rfq_items")
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  poNo          String              @unique @db.VarChar(50)
  poDate        DateTime
  vendorId      Int
  projectId     Int?
  rfqId         Int?
  status        PurchaseOrderStatus @default(DRAFT)
  subtotal      Decimal             @default(0.00) @db.Decimal(15, 2)
  discount      Decimal             @default(0.00) @db.Decimal(15, 2)
  transportCost Decimal             @default(0.00) @db.Decimal(15, 2)
  grandTotal    Decimal             @default(0.00) @db.Decimal(15, 2)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  purchaseId    Int?                @unique
  items         PurchaseOrderItem[]
  project       Project?            @relation(fields: [projectId], references: [id])
  purchase      Purchase?           @relation("PurchaseOrderPurchase", fields: [purchaseId], references: [id])
  rfq           RFQ?                @relation(fields: [rfqId], references: [id])
  vendor        Vendor              @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([projectId])
  @@index([rfqId])
  @@index([purchaseId])
  @@index([status])
  @@index([poDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  materialId      Int
  quantity        Decimal       @db.Decimal(15, 3)
  unit            String        @db.VarChar(30)
  unitPrice       Decimal       @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  material        Material      @relation(fields: [materialId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("purchase_order_items")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_BANKING
  OTHER
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ON_HOLD
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum PurchaseRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RFQStatus {
  DRAFT
  SENT
  QUOTED
  EVALUATED
  AWARDED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  SENT
  PARTIAL
  COMPLETED
  CANCELLED
}

enum BOQStatus {
  DRAFT
  FINAL
  APPROVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  PROJECT_USAGE
  RETURN
  DAMAGE
  ADJUSTMENT
}
