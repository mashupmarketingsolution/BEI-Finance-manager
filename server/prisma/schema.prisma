generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AuditEvent {
  id Int @id @default(autoincrement())
  actorId Int
  actorName String @db.VarChar(150)
  actorUsername String @db.VarChar(50)
  actorRole String @db.VarChar(30)
  method String @db.VarChar(10)
  path String @db.VarChar(300)
  resource String @db.VarChar(80)
  recordId Int?
  action String @db.VarChar(40)
  outcome String @default("PENDING") @db.VarChar(20)
  statusCode Int?
  changedFields Json
  beforeSnapshot Json?
  afterSnapshot Json?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([createdAt])
  @@index([actorId])
  @@index([resource,recordId])
  @@index([outcome])
  @@map("audit_events")
}

model Customer {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(150)
  phone        String?      @db.VarChar(30)
  email        String?      @db.VarChar(150)
  companyName  String?      @db.VarChar(150)
  address      String?      @db.Text
  source       LeadSource   @default(OTHER)
  customerType CustomerType @default(INDIVIDUAL)
  status       RecordStatus @default(ACTIVE)
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invoices       ClientInvoice[]
  projects       Project[]
  convertedLeads Lead[]      @relation("LeadConvertedCustomer")
  quotations     Quotation[]

  @@index([phone])
  @@index([status])
  @@map("customers")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model User {
  financialRequests FinancialRequest[] @relation("FinancialRequester")
  financialActions FinancialEvent[]
  paymentRequests VendorPaymentRequest[] @relation("PaymentRequester")
  paymentReviewActions VendorPaymentEvent[]
  procurementCreated ProcurementApproval[] @relation("ProcurementCreator")
  procurementActions ProcurementApprovalEvent[]
  inspectionApprovalActions InspectionApproval[]
  role UserRole @default(SITE_SUPERVISOR)
  accessVersion Int @default(1)
  assignedSiteInspections SiteInspection[] @relation("InspectionResponsible")
  createdSiteInspections SiteInspection[] @relation("InspectionCreator")
  updatedSiteInspections SiteInspection[] @relation("InspectionEditor")
  assignedSiteTasks SiteTask[] @relation("TaskResponsible")
  createdSiteTasks SiteTask[] @relation("TaskCreator")
  updatedSiteTasks SiteTask[] @relation("TaskEditor")
  assignedSiteReports SiteReport[] @relation("SiteResponsible")
  createdSiteReports SiteReport[] @relation("SiteCreator")
  updatedSiteReports SiteReport[] @relation("SiteEditor")
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(150)
  username     String       @unique @db.VarChar(50)
  email        String?      @db.VarChar(150)
  phone        String?      @db.VarChar(30)
  passwordHash String       @db.VarChar(255)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedLeads Lead[] @relation("LeadAssignedTo")

  @@index([status])
  @@index([phone])
  @@map("users")
}

enum UserRole {
  ADMIN
  ACCOUNTS
  PROJECT_MANAGER
  SITE_SUPERVISOR
  PROCUREMENT_OFFICER
  STOREKEEPER
  VIEWER
}

model Lead {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(150)
  phone       String? @db.VarChar(30)
  email       String? @db.VarChar(150)
  companyName String? @db.VarChar(150)
  address     String? @db.Text

  source LeadSource @default(OTHER)
  status LeadStatus @default(NEW)
  notes  String?    @db.Text

  assignedToId        Int?
  convertedCustomerId Int?
  convertedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo        User?     @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedCustomer Customer? @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([status])
  @@index([source])
  @@index([assignedToId])
  @@index([convertedCustomerId])
  @@map("leads")
}

enum LeadSource {
  FACEBOOK
  WEBSITE
  REFERRAL
  PHONE
  WALK_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  SITE_VISIT
  QUOTATION
  NEGOTIATION
  WON
  LOST
  CONVERTED
}

model Project {
  siteInspections SiteInspection[]
  siteTasks SiteTask[]
  siteReports SiteReport[]
  workerAdvances WorkerAdvance[]
  workerRates WorkerRate[]
  attendance WorkerAttendance[]
  payrollAccruals PayrollAccrual[]
  overheadAllocations OverheadAllocation[]
  invoices         ClientInvoice[]
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(150)
  contractValue    Decimal           @default(0.00) @db.Decimal(15, 2)
  notes            String?           @db.Text
  status           ProjectStatus     @default(ONGOING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customerId       Int?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  boqs             BOQ[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
  purchases        Purchase[]
  rfqs             RFQ[]
  stockMovements   StockMovement[]
  transactions     Transaction[]

  @@index([customerId])
  @@map("projects")
}

model SiteReport {
  inspections SiteInspection[]
  tasks SiteTaskReport[]
  id Int @id @default(autoincrement())
  projectId Int
  reportDate DateTime
  title String @db.VarChar(150)
  workSummary String @db.Text
  progress Decimal @db.Decimal(5,2)
  issues String? @db.Text
  nextPlan String? @db.Text
  responsibleId Int?
  createdById Int
  updatedById Int
  version Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  responsible User? @relation("SiteResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  creator User @relation("SiteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  editor User @relation("SiteEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  photos SitePhoto[]
  @@unique([projectId, reportDate])
  @@map("site_reports")
}

model SitePhoto {
  id Int @id @default(autoincrement())
  reportId Int
  name String @db.VarChar(150)
  mime String @db.VarChar(30)
  size Int
  data Bytes @db.MediumBlob
  createdAt DateTime @default(now())
  report SiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@map("site_photos")
}

model SiteTask {
  inspections SiteInspection[]
  id Int @id @default(autoincrement())
  projectId Int
  title String @db.VarChar(150)
  description String? @db.Text
  blockers String? @db.Text
  startDate DateTime
  dueDate DateTime
  status String @default("PENDING") @db.VarChar(20)
  priority String @default("NORMAL") @db.VarChar(10)
  responsibleId Int?
  createdById Int
  updatedById Int
  completedAt DateTime?
  archivedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  responsible User? @relation("TaskResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  creator User @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  editor User @relation("TaskEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  reports SiteTaskReport[]
  @@index([projectId, status, dueDate])
  @@map("site_tasks")
}

model SiteTaskReport {
  taskId Int
  reportId Int
  task SiteTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  report SiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@id([taskId, reportId])
  @@map("site_task_reports")
}

model SiteInspection {
  approvalState String @default("NOT_SUBMITTED") @db.VarChar(20)
  approvalEvents InspectionApproval[]
  id Int @id @default(autoincrement())
  projectId Int
  taskId Int?
  reportId Int?
  title String @db.VarChar(150)
  inspectionDate DateTime
  inspectorId Int
  checklist Json
  notes String? @db.Text
  status String @default("DRAFT") @db.VarChar(20)
  createdById Int
  updatedById Int
  completedAt DateTime?
  archivedAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task SiteTask? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  report SiteReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  inspector User @relation("InspectionResponsible", fields: [inspectorId], references: [id], onDelete: Restrict)
  creator User @relation("InspectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  editor User @relation("InspectionEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  @@index([projectId, inspectionDate])
  @@map("site_inspections")
}

model InspectionApproval {
  id Int @id @default(autoincrement())
  inspectionId Int
  actorId Int
  actorRole String @db.VarChar(30)
  action String @db.VarChar(20)
  notes String? @db.Text
  snapshot Json?
  createdAt DateTime @default(now())
  inspection SiteInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@map("inspection_approvals")
}

model Worker {
  advances WorkerAdvance[]
  rates WorkerRate[]
  attendance WorkerAttendance[]
  payrollAccruals PayrollAccrual[]
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(150)
  phone        String?       @db.VarChar(30)
  role         String?       @db.VarChar(100)
  status       RecordStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("workers")
}

model Vendor {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(150)
  companyName    String?               @db.VarChar(150)
  phone          String?               @db.VarChar(30)
  address        String?               @db.Text
  status         RecordStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]
  rfqVendors     RFQVendor[]
  awardedRFQs    RFQ[]                 @relation("RFQAwardedVendor")
  transactions   Transaction[]
  materialPrices VendorMaterialPrice[]

  @@map("vendors")
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(100)
  type         TransactionType
  status       RecordStatus    @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]

  @@unique([name, type])
  @@map("categories")
}

enum TransactionSource {
  WORKER_ADVANCE
  CLIENT_PAYMENT
  MANUAL
  PURCHASE
  PURCHASE_PAYMENT
}

model Transaction {
  financialRequest FinancialRequest?
  workerAdvance WorkerAdvance?
  payrollPayment PayrollPayment?
  overheadAllocations OverheadAllocation[]
  purchasePayment PurchasePayment?
  invoicePayment InvoicePayment?
  id              Int               @id @default(autoincrement())
  transactionDate DateTime
  type            TransactionType
  source          TransactionSource @default(MANUAL)
  amount          Decimal           @db.Decimal(15, 2)
  paymentMethod   PaymentMethod     @default(CASH)
  description     String?           @db.Text
  notes           String?           @db.Text
  projectId       Int?
  categoryId      Int?
  workerId        Int?
  vendorId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  category        Category?         @relation(fields: [categoryId], references: [id])
  project         Project?          @relation(fields: [projectId], references: [id])
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  worker          Worker?           @relation(fields: [workerId], references: [id])

  @@index([transactionDate])
  @@index([type])
  @@index([projectId])
  @@index([categoryId], map: "transactions_categoryId_fkey")
  @@index([vendorId], map: "transactions_vendorId_fkey")
  @@index([workerId], map: "transactions_workerId_fkey")
  @@map("transactions")
}

model PayrollAccrual {
  financialRequests FinancialRequest[]
  batchId Int?
  batch PayrollBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  advanceAllocations WorkerAdvanceAllocation[]
  attendance WorkerAttendance?
  id Int @id @default(autoincrement())
  projectId Int
  workerId Int
  reference String @unique @db.VarChar(100)
  description String @db.VarChar(500)
  earnedDate DateTime
  amount Decimal @db.Decimal(15, 2)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  payments PayrollPayment[]
  createdAt DateTime @default(now())
  @@map("payroll_accruals")
}

model PayrollBatch {
  id Int @id @default(autoincrement())
  reference String @unique @db.VarChar(100)
  fromDate DateTime
  toDate DateTime
  projectId Int?
  workerId Int?
  snapshot Json
  createdAt DateTime @default(now())
  reversedAt DateTime?
  accruals PayrollAccrual[]
  @@map("payroll_batches")
}

model WorkerAdvance {
  id Int @id @default(autoincrement())
  workerId Int
  projectId Int
  transactionId Int? @unique
  reference String @unique @db.VarChar(100)
  paymentDate DateTime
  amount Decimal @db.Decimal(15,2)
  paymentMethod PaymentMethod
  notes String? @db.VarChar(500)
  reversedAt DateTime?
  createdAt DateTime @default(now())
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  allocations WorkerAdvanceAllocation[]
  @@map("worker_advances")
}

model WorkerAdvanceAllocation {
  id Int @id @default(autoincrement())
  advanceId Int
  accrualId Int
  amount Decimal @db.Decimal(15,2)
  allocationDate DateTime
  advance WorkerAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  accrual PayrollAccrual @relation(fields: [accrualId], references: [id], onDelete: Restrict)
  @@unique([advanceId, accrualId])
  @@map("worker_advance_allocations")
}

model WorkerRate {
  id Int @id @default(autoincrement())
  workerId Int
  projectId Int
  effectiveDate DateTime
  dailyRate Decimal @db.Decimal(15, 2)
  overtimeRate Decimal @db.Decimal(15, 2)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@unique([workerId, projectId, effectiveDate])
  @@map("worker_rates")
}

model WorkerAttendance {
  id Int @id @default(autoincrement())
  workerId Int
  projectId Int
  workDate DateTime
  dayUnits Decimal @db.Decimal(3, 2)
  overtimeHours Decimal @db.Decimal(4, 2)
  dailyRate Decimal @db.Decimal(15, 2)
  overtimeRate Decimal @db.Decimal(15, 2)
  amount Decimal @db.Decimal(15, 2)
  notes String? @db.VarChar(500)
  payrollAccrualId Int? @unique
  payrollAccrual PayrollAccrual? @relation(fields: [payrollAccrualId], references: [id], onDelete: Restrict)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([workerId, workDate])
  @@map("worker_attendance")
}

model PayrollPayment {
  id Int @id @default(autoincrement())
  accrualId Int
  transactionId Int @unique
  accrual PayrollAccrual @relation(fields: [accrualId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  @@map("payroll_payments")
}

model FinancialRequest {
  id Int @id @default(autoincrement())
  kind String @db.VarChar(20)
  creatorId Int
  accrualId Int?
  payload Json
  snapshot Json
  targetFingerprint String? @db.VarChar(64)
  state String @default("SUBMITTED") @db.VarChar(20)
  version Int @default(1)
  transactionId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation("FinancialRequester",fields:[creatorId],references:[id],onDelete:Restrict)
  accrual PayrollAccrual? @relation(fields:[accrualId],references:[id],onDelete:SetNull)
  transaction Transaction? @relation(fields:[transactionId],references:[id],onDelete:SetNull)
  events FinancialEvent[]
  @@index([state,kind])
  @@index([accrualId])
  @@map("financial_requests")
}

model FinancialEvent {
  id Int @id @default(autoincrement())
  requestId Int
  actorId Int
  actorRole String @db.VarChar(30)
  action String @db.VarChar(20)
  notes String? @db.Text
  snapshot Json
  createdAt DateTime @default(now())
  request FinancialRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@index([requestId])
  @@map("financial_events")
}

model OverheadAllocation {
  id Int @id @default(autoincrement())
  transactionId Int
  projectId Int
  amount Decimal @db.Decimal(15, 2)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@unique([transactionId, projectId])
  @@map("overhead_allocations")
}

model MaterialCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  materials   Material[]

  @@map("material_categories")
}

model Material {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique @db.VarChar(50)
  name                 String                @db.VarChar(150)
  categoryId           Int?
  subCategory          String?               @db.VarChar(100)
  brand                String?               @db.VarChar(100)
  modelCode            String?               @db.VarChar(100)
  specification        String?               @db.Text
  color                String?               @db.VarChar(100)
  size                 String?               @db.VarChar(100)
  unit                 String                @db.VarChar(30)
  description          String?               @db.Text
  status               RecordStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  boqItems             BOQItem[]
  quotationItems       QuotationItem[]
  category             MaterialCategory?     @relation(fields: [categoryId], references: [id])
  purchaseItems        PurchaseItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]
  rfqItems             RFQItem[]
  stockMovements       StockMovement[]
  vendorPrices         VendorMaterialPrice[]

  @@index([categoryId])
  @@index([name])
  @@index([brand])
  @@map("materials")
}

model Purchase {
  paymentRequests VendorPaymentRequest[]
  vendorBillNo String? @db.VarChar(100)
  dueDate DateTime? @db.Date
  @@unique([vendorId, vendorBillNo])
  id            Int                   @id @default(autoincrement())
  purchaseNo    String                @unique @db.VarChar(50)
  purchaseDate  DateTime
  vendorId      Int
  projectId     Int?
  subtotal      Decimal               @default(0.00) @db.Decimal(15, 2)
  discount      Decimal               @default(0.00) @db.Decimal(15, 2)
  transportCost Decimal               @default(0.00) @db.Decimal(15, 2)
  grandTotal    Decimal               @default(0.00) @db.Decimal(15, 2)
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  paidAmount    Decimal               @default(0.00) @db.Decimal(15, 2)
  dueAmount     Decimal               @default(0.00) @db.Decimal(15, 2)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         PurchaseItem[]
  purchaseOrder PurchaseOrder?        @relation("PurchaseOrderPurchase")
  payments      PurchasePayment[]
  project       Project?              @relation(fields: [projectId], references: [id])
  vendor        Vendor                @relation(fields: [vendorId], references: [id])

  @@index([purchaseDate])
  @@index([vendorId])
  @@index([projectId])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchasePayment {
  approvalRequest VendorPaymentRequest?
  transactionId Int? @unique
  transaction Transaction? @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  id            Int           @id @default(autoincrement())
  purchaseId    Int
  paymentDate   DateTime
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @default(CASH)
  referenceNo   String?       @db.VarChar(100)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([paymentDate])
  @@map("purchase_payments")
}

model VendorPaymentRequest {
  id Int @id @default(autoincrement())
  purchaseId Int
  creatorId Int
  amount Decimal @db.Decimal(15,2)
  paymentDate DateTime @db.Date
  paymentMethod PaymentMethod
  referenceNo String? @db.VarChar(100)
  notes String? @db.Text
  state String @default("SUBMITTED") @db.VarChar(20)
  version Int @default(1)
  billFingerprint String @db.VarChar(64)
  snapshot Json
  paymentId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  creator User @relation("PaymentRequester",fields:[creatorId],references:[id],onDelete:Restrict)
  payment PurchasePayment? @relation(fields:[paymentId],references:[id],onDelete:SetNull)
  events VendorPaymentEvent[]
  @@index([state])
  @@index([purchaseId])
  @@map("vendor_payment_requests")
}

model VendorPaymentEvent {
  id Int @id @default(autoincrement())
  requestId Int
  actorId Int
  actorRole String @db.VarChar(30)
  action String @db.VarChar(20)
  notes String? @db.Text
  snapshot Json
  createdAt DateTime @default(now())
  request VendorPaymentRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@index([requestId])
  @@map("vendor_payment_events")
}

model PurchaseItem {
  id               Int      @id @default(autoincrement())
  purchaseId       Int
  materialId       Int
  quantity         Decimal  @db.Decimal(15, 3)
  receivedQuantity Decimal  @default(0) @db.Decimal(15, 3)
  unit             String   @db.VarChar(30)
  unitPrice        Decimal  @db.Decimal(15, 2)
  total            Decimal  @db.Decimal(15, 2)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  material         Material @relation(fields: [materialId], references: [id])
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([materialId])
  @@map("purchase_items")
}

model StockMovement {
  id            Int               @id @default(autoincrement())
  materialId    Int
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(15, 3)
  unit          String            @db.VarChar(30)
  referenceType String?           @db.VarChar(50)
  referenceId   Int?
  projectId     Int?
  unitCost      Decimal?          @db.Decimal(15, 2)
  notes         String?           @db.Text
  movementDate  DateTime          @default(now())
  createdAt     DateTime          @default(now())
  material      Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id])

  @@index([materialId])
  @@index([movementType])
  @@index([movementDate])
  @@index([projectId])
  @@map("stock_movements")
}

model BOQ {
  id        Int       @id @default(autoincrement())
  boqNo     String    @unique @db.VarChar(50)
  name      String    @db.VarChar(150)
  projectId Int
  status    BOQStatus @default(DRAFT)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     BOQItem[]
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("boqs")
}

model BOQItem {
  id                 Int             @id @default(autoincrement())
  boqId              Int
  materialId         Int
  description        String?         @db.Text
  quantity           Decimal         @db.Decimal(15, 3)
  unit               String          @db.VarChar(30)
  estimatedUnitPrice Decimal         @default(0.00) @db.Decimal(15, 2)
  estimatedTotal     Decimal         @default(0.00) @db.Decimal(15, 2)
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  boq                BOQ             @relation(fields: [boqId], references: [id], onDelete: Cascade)
  material           Material        @relation(fields: [materialId], references: [id])
  quotationItems     QuotationItem[]

  @@index([boqId])
  @@index([materialId])
  @@map("boq_items")
}

model Quotation {
  id          Int    @id @default(autoincrement())
  quotationNo String @unique @db.VarChar(50)

  customerId Int
  projectId  Int?

  quotationDate DateTime
  validUntil    DateTime?

  status     QuotationStatus @default(DRAFT)
  revisionNo Int             @default(1)

  subtotal Decimal @default(0.00) @db.Decimal(15, 2)

  discountType   DiscountType?
  discountValue  Decimal       @default(0.00) @db.Decimal(15, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(15, 2)

  taxType   TaxType?
  taxRate   Decimal  @default(0.00) @db.Decimal(8, 3)
  taxAmount Decimal  @default(0.00) @db.Decimal(15, 2)

  grandTotal Decimal @default(0.00) @db.Decimal(15, 2)

  paymentTerms       String? @db.Text
  termsAndConditions String? @db.Text
  notes              String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  originalQuotationId Int?
  originalQuotation   Quotation?  @relation("QuotationRevisions", fields: [originalQuotationId], references: [id], onDelete: Restrict)
  revisions           Quotation[] @relation("QuotationRevisions")

  items             QuotationItem[]
  paymentMilestones QuotationPaymentMilestone[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([quotationDate])
  @@index([originalQuotationId])
  @@unique([originalQuotationId, revisionNo])
  @@map("quotations")
}

model QuotationItem {
  id          Int @id @default(autoincrement())
  quotationId Int

  category      String  @default("OTHER") @db.VarChar(30)
  description   String  @db.VarChar(255)
  specification String? @db.Text

  pricingType QuotationPricingType @default(UNIT_PRICE)

  quantity  Decimal? @db.Decimal(15, 3)
  unit      String?  @db.VarChar(30)
  unitPrice Decimal? @db.Decimal(15, 2)

  lineTotal Decimal @db.Decimal(15, 2)

  materialId Int?
  boqItemId  Int?

  notes     String? @db.Text
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  boqItem  BOQItem?  @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([materialId])
  @@index([boqItemId])
  @@index([pricingType])
  @@map("quotation_items")
}

model QuotationPaymentMilestone {
  invoice ClientInvoice?
  id          Int @id @default(autoincrement())
  quotationId Int

  milestoneNo Int
  title       String @db.VarChar(150)

  percentage Decimal? @db.Decimal(8, 3)
  amount     Decimal  @db.Decimal(15, 2)

  dueTrigger String? @db.VarChar(255)
  notes      String? @db.Text

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_payment_milestones")
}

model VendorMaterialPrice {
  id            Int      @id @default(autoincrement())
  materialId    Int
  vendorId      Int
  unitPrice     Decimal  @db.Decimal(15, 2)
  unit          String   @db.VarChar(30)
  minimumQty    Decimal? @db.Decimal(15, 2)
  leadTimeDays  Int?
  effectiveDate DateTime @default(now())
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([vendorId])
  @@index([materialId, vendorId])
  @@index([effectiveDate])
  @@map("vendor_material_prices")
}

model PurchaseRequest {
  approval ProcurementApproval? @relation("RequestApproval")
  id          Int                     @id @default(autoincrement())
  requestNo   String                  @unique @db.VarChar(50)
  requestDate DateTime
  projectId   Int
  status      PurchaseRequestStatus   @default(DRAFT)
  priority    PurchaseRequestPriority @default(NORMAL)
  notes       String?                 @db.Text
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  items       PurchaseRequestItem[]
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([requestDate])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int
  materialId        Int
  quantity          Decimal         @db.Decimal(15, 3)
  unit              String          @db.VarChar(30)
  requiredDate      DateTime?
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  material          Material        @relation(fields: [materialId], references: [id])
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([materialId])
  @@map("purchase_request_items")
}

model RFQ {
  id              Int             @id @default(autoincrement())
  rfqNo           String          @unique @db.VarChar(50)
  rfqDate         DateTime
  projectId       Int
  status          RFQStatus       @default(DRAFT)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  awardedVendorId Int?
  purchaseOrders  PurchaseOrder[]
  items           RFQItem[]
  vendors         RFQVendor[]
  awardedVendor   Vendor?         @relation("RFQAwardedVendor", fields: [awardedVendorId], references: [id])
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([rfqDate])
  @@index([awardedVendorId], map: "rfqs_awardedVendorId_fkey")
  @@map("rfqs")
}

model RFQVendor {
  id          Int      @id @default(autoincrement())
  rfqId       Int
  vendorId    Int
  quotedTotal Decimal? @db.Decimal(15, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@map("rfq_vendors")
}

model RFQItem {
  id         Int      @id @default(autoincrement())
  rfqId      Int
  materialId Int
  quantity   Decimal  @db.Decimal(15, 3)
  unit       String   @db.VarChar(30)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  material   Material @relation(fields: [materialId], references: [id])
  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([materialId])
  @@map("rfq_items")
}

model PurchaseOrder {
  approval ProcurementApproval? @relation("OrderApproval")
  id            Int                 @id @default(autoincrement())
  poNo          String              @unique @db.VarChar(50)
  poDate        DateTime
  vendorId      Int
  projectId     Int?
  rfqId         Int?
  status        PurchaseOrderStatus @default(DRAFT)
  subtotal      Decimal             @default(0.00) @db.Decimal(15, 2)
  discount      Decimal             @default(0.00) @db.Decimal(15, 2)
  transportCost Decimal             @default(0.00) @db.Decimal(15, 2)
  grandTotal    Decimal             @default(0.00) @db.Decimal(15, 2)
  notes         String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  purchaseId    Int?                @unique
  items         PurchaseOrderItem[]
  project       Project?            @relation(fields: [projectId], references: [id])
  purchase      Purchase?           @relation("PurchaseOrderPurchase", fields: [purchaseId], references: [id])
  rfq           RFQ?                @relation(fields: [rfqId], references: [id])
  vendor        Vendor              @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([projectId])
  @@index([rfqId])
  @@index([purchaseId])
  @@index([status])
  @@index([poDate])
  @@map("purchase_orders")
}

model ProcurementApproval {
  id Int @id @default(autoincrement())
  requestId Int? @unique
  orderId Int? @unique
  creatorId Int?
  state String @default("NOT_SUBMITTED") @db.VarChar(20)
  version Int @default(1)
  approvedFingerprint String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  request PurchaseRequest? @relation("RequestApproval", fields: [requestId], references: [id], onDelete: Cascade)
  order PurchaseOrder? @relation("OrderApproval", fields: [orderId], references: [id], onDelete: Cascade)
  creator User? @relation("ProcurementCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  events ProcurementApprovalEvent[]
  @@map("procurement_approvals")
}

model ProcurementApprovalEvent {
  id Int @id @default(autoincrement())
  approvalId Int
  actorId Int
  actorRole String @db.VarChar(30)
  action String @db.VarChar(20)
  notes String? @db.Text
  snapshot Json
  createdAt DateTime @default(now())
  approval ProcurementApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@map("procurement_approval_events")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  materialId      Int
  quantity        Decimal       @db.Decimal(15, 3)
  unit            String        @db.VarChar(30)
  unitPrice       Decimal       @db.Decimal(15, 2)
  total           Decimal       @db.Decimal(15, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  material        Material      @relation(fields: [materialId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([materialId])
  @@map("purchase_order_items")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_BANKING
  OTHER
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  ON_HOLD
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum PurchaseRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RFQStatus {
  DRAFT
  SENT
  QUOTED
  EVALUATED
  AWARDED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  SENT
  PARTIAL
  COMPLETED
  CANCELLED
}

enum BOQStatus {
  DRAFT
  FINAL
  APPROVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuotationPricingType {
  UNIT_PRICE
  FIXED_AMOUNT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TaxType {
  PERCENT
  FIXED
}

enum StockMovementType {
  PURCHASE
  PROJECT_USAGE
  RETURN
  DAMAGE
  ADJUSTMENT
}

model ClientInvoice {
  id Int @id @default(autoincrement())
  invoiceNo String @unique @db.VarChar(50)
  customerId Int
  projectId Int
  milestoneId Int? @unique
  customerName String @db.VarChar(150)
  customerAddress String? @db.Text
  invoiceDate DateTime @db.Date
  dueDate DateTime @db.Date
  description String @db.Text
  amount Decimal @db.Decimal(15,2)
  status InvoiceStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields:[customerId], references:[id], onDelete:Restrict)
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  milestone QuotationPaymentMilestone? @relation(fields:[milestoneId], references:[id], onDelete:Restrict)
  payments InvoicePayment[]
  @@index([customerId])
  @@index([projectId])
  @@index([status,dueDate])
  @@map("client_invoices")
}

model InvoicePayment {
  id Int @id @default(autoincrement())
  invoiceId Int
  transactionId Int @unique
  amount Decimal @db.Decimal(15,2)
  createdAt DateTime @default(now())
  invoice ClientInvoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  transaction Transaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  @@index([invoiceId])
  @@map("invoice_payments")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}
